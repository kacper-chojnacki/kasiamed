---
import Logo from './Logo.astro';
import Placeholder from './Placeholder.astro';
import { company, fullAddress, telHref } from '../data/company';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-navy-100">
  <div class="container-page flex flex-col gap-10 py-14 md:flex-row md:items-start md:justify-between">
    <div>
      <Logo variant="light" />
      <p class="mt-5 text-lg">{fullAddress}</p>
    </div>
    <div class="md:text-right">
      <p class="text-lg">Telefon, całą dobę</p>
      <a href={telHref} class="mt-1 block text-3xl font-extrabold text-white hover:underline">{company.phone.display}</a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-3 py-6 text-base text-navy-200 md:flex-row md:items-center md:justify-between">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>© {year} {company.legalName ?? company.name}</span>
        <span aria-hidden="true">·</span>
        <span>NIP: {company.nip ?? <Placeholder label="NIP" />}</span>
        <span aria-hidden="true">·</span>
        <span>REGON: {company.regon ?? <Placeholder label="REGON" />}</span>
      </p>
      <a href={url('polityka-prywatnosci/')} class="underline underline-offset-4 hover:text-white">Polityka prywatności</a>
    </div>
  </div>
</footer>
