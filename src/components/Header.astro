---
import Menu from '@lucide/astro/icons/menu';
import Phone from '@lucide/astro/icons/phone';
import X from '@lucide/astro/icons/x';
import Logo from './Logo.astro';
import { company, telHref } from '../data/company';
import { url } from '../lib/url';

const nav = [
  { href: url('#uslugi'), label: 'Usługi' },
  { href: url('#o-nas'), label: 'O nas' },
  { href: url('#jak-dzialamy'), label: 'Jak działamy' },
  { href: url('#faq'), label: 'FAQ' },
  { href: url('#kontakt'), label: 'Kontakt' },
];
---

<header class="sticky top-0 z-40 border-b border-slate-900/5 bg-white/85 backdrop-blur-xl" data-header>
  <div class="container-page flex h-20 items-center justify-between gap-6">
    <a href={url()} class="shrink-0" title="Strona główna">
      <Logo />
    </a>

    <nav aria-label="Główna nawigacja" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-full px-4 py-2 text-[0.92rem] font-medium text-slate-600 transition hover:bg-navy-50 hover:text-navy-800"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={telHref} class="btn-primary hidden !min-h-11 !px-5 sm:inline-flex">
        <Phone class="size-[1.1rem]" aria-hidden="true" />
        <span>{company.phone.display}</span>
      </a>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full text-navy-800 ring-1 ring-navy-100 transition hover:bg-navy-50 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Otwórz menu"
        data-menu-toggle
      >
        <Menu class="size-5" aria-hidden="true" data-icon-open />
        <X class="hidden size-5" aria-hidden="true" data-icon-close />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-900/5 bg-white lg:hidden" data-menu>
    <nav aria-label="Menu mobilne" class="container-page py-4">
      <ul class="flex flex-col">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-xl px-3 py-3.5 text-lg font-medium text-navy-900 hover:bg-navy-50"
                data-menu-link
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={telHref} class="btn-primary mt-4 w-full">
        <Phone class="size-5" aria-hidden="true" />
        Zadzwoń: {company.phone.display}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
