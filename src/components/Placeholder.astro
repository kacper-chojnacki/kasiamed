---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span
  class="inline-flex items-center gap-1 rounded-md border border-dashed border-amber-500/70 bg-amber-50 px-1.5 py-0.5 align-baseline text-[0.8em] font-medium text-amber-900"
  title="Dane do uzupełnienia"
>
  [DO UZUPEŁNIENIA: {label}]
</span>
