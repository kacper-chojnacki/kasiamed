---
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
---

<div class="bg-navy-950 text-base text-navy-100">
  <div class="container-page flex items-center justify-center gap-2 py-2 text-center">
    <TriangleAlert class="size-4 shrink-0 text-brand-red-500" aria-hidden="true" />
    <p>
      Zagrożenie życia? Dzwoń na numer alarmowy
      <a href="tel:112" class="font-bold text-white underline-offset-2 hover:underline">112</a> lub
      <a href="tel:999" class="font-bold text-white underline-offset-2 hover:underline">999</a>.
    </p>
  </div>
</div>
