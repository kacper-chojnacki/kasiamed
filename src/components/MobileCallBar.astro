---
import Phone from '@lucide/astro/icons/phone';
import { company, telHref } from '../data/company';
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-900/10 bg-white/95 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-xl sm:hidden">
  <a href={telHref} class="flex min-h-14 w-full items-center justify-center gap-3 rounded-2xl bg-brand-red-600 text-xl font-bold text-white">
    <Phone class="size-6" aria-hidden="true" />
    Zadzwoń: {company.phone.display}
  </a>
</div>
