---
import StarMark from './StarMark.astro';

interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}

const { variant = 'dark', class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <span class:list={['grid size-11 shrink-0 place-items-center rounded-full', variant === 'light' ? 'bg-white' : 'bg-white ring-1 ring-navy-100 shadow-sm']}>
    <StarMark class="size-8" />
  </span>
  <span class="flex flex-col leading-none">
    <span class:list={['font-display text-[1.35rem] font-extrabold tracking-tight', variant === 'light' ? 'text-white' : 'text-navy-800']}>
      KASIA<span class="text-brand-red-600"> </span>MED
    </span>
    <span class:list={['mt-1 hidden text-[0.62rem] font-semibold tracking-[0.2em] uppercase min-[400px]:block', variant === 'light' ? 'text-navy-200' : 'text-slate-500']}>
      Transport · Opieka · Ratownictwo
    </span>
  </span>
</span>
