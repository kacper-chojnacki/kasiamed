---
import Send from '@lucide/astro/icons/send';
import { company } from '../data/company';
import { url } from '../lib/url';
import { siteConfig } from '../../site.config.mjs';

const accessKey = siteConfig.web3formsAccessKey;
const isLive = accessKey.length > 0;
const redirect = new URL(url('dziekujemy/'), Astro.site).href;
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="card p-6 sm:p-8"
  data-contact-form
  data-live={String(isLive)}
  novalidate
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={`Prośba o kontakt ze strony ${company.name}`} />
  <input type="hidden" name="from_name" value={`Strona ${company.name}`} />
  <input type="hidden" name="redirect" value={redirect} />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <h3 class="text-2xl font-bold">Wolisz, żebyśmy oddzwonili?</h3>
  <p class="mt-2 text-lg text-slate-700">Zostaw numer telefonu, a zadzwonimy najszybciej, jak to możliwe.</p>

  <div class="mt-6 space-y-5">
    <div>
      <label for="cf-name" class="field-label">Imię i nazwisko</label>
      <input id="cf-name" name="name" type="text" class="field" autocomplete="name" required maxlength="100" />
    </div>
    <div>
      <label for="cf-phone" class="field-label">Numer telefonu</label>
      <input
        id="cf-phone"
        name="Telefon"
        type="tel"
        class="field"
        autocomplete="tel"
        inputmode="tel"
        required
        pattern="[\d\s\+\-\(\)]{9,20}"
      />
    </div>
    <div>
      <label for="cf-message" class="field-label">W czym możemy pomóc? <span class="font-normal text-slate-600">(nieobowiązkowe)</span></label>
      <textarea id="cf-message" name="Wiadomość" rows="3" class="field resize-y" maxlength="2000"></textarea>
      <p class="mt-2 text-base text-slate-600">Prosimy nie wpisywać tu szczegółów o stanie zdrowia.</p>
    </div>
  </div>

  <div class="mt-5 flex items-start gap-3">
    <input
      id="cf-consent"
      name="Zgoda na przetwarzanie danych"
      type="checkbox"
      value="Tak"
      required
      class="mt-0.5 size-6 shrink-0 accent-navy-700"
    />
    <label for="cf-consent" class="text-base leading-relaxed text-slate-700">
      Zgadzam się na kontakt w sprawie mojego zapytania
      (<a href={url('polityka-prywatnosci/')} class="font-medium text-navy-700 underline underline-offset-2">polityka prywatności</a>).
    </label>
  </div>

  <button
    type="submit"
    class="mt-6 inline-flex min-h-16 w-full items-center justify-center gap-3 rounded-2xl bg-navy-800 px-8 text-xl font-bold text-white transition hover:bg-navy-700 disabled:cursor-not-allowed disabled:opacity-60"
    disabled={!isLive}
    data-submit
  >
    <Send class="size-6" aria-hidden="true" />
    <span data-submit-label>Poproś o telefon</span>
  </button>

  <div class="mt-5 hidden rounded-2xl px-5 py-4 text-lg" role="status" aria-live="polite" data-status></div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const isLive = form.dataset.live === 'true';

    // The button starts disabled in preview mode so the no-JS fallback never posts without a key.
    submit.disabled = false;

    const show = (kind: 'success' | 'error' | 'info', message: string) => {
      status.className = 'mt-5 rounded-2xl px-5 py-4 text-lg';
      status.classList.add(
        ...{
          success: ['bg-emerald-50', 'text-emerald-900', 'ring-1', 'ring-emerald-200'],
          error: ['bg-red-50', 'text-red-900', 'ring-1', 'ring-red-200'],
          info: ['bg-navy-50', 'text-navy-900', 'ring-1', 'ring-navy-200'],
        }[kind],
      );
      status.textContent = message;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (!isLive) {
        show(
          'info',
          'To wersja podglądowa strony. Formularz zostanie aktywowany po podłączeniu skrzynki e-mail. Prosimy o kontakt telefoniczny.',
        );
        return;
      }

      submit.disabled = true;
      label.textContent = 'Wysyłanie…';

      try {
        const data = Object.fromEntries(new FormData(form));
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message);

        form.reset();
        show('success', 'Dziękujemy! Oddzwonimy najszybciej, jak to możliwe.');
      } catch {
        show('error', 'Nie udało się wysłać wiadomości. Spróbuj ponownie lub zadzwoń do nas.');
      } finally {
        submit.disabled = false;
        label.textContent = 'Poproś o telefon';
      }
    });
  }
</script>
