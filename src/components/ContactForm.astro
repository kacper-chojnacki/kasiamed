---
import Send from '@lucide/astro/icons/send';
import { company, contactServices } from '../data/company';
import { url } from '../lib/url';
import { siteConfig } from '../../site.config.mjs';

const accessKey = siteConfig.web3formsAccessKey;
const isLive = accessKey.length > 0;
const redirect = new URL(url('dziekujemy/'), Astro.site).href;
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="card p-6 sm:p-8"
  data-contact-form
  data-live={String(isLive)}
  novalidate
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={`Nowe zapytanie ze strony ${company.name}`} />
  <input type="hidden" name="from_name" value={`Strona ${company.name}`} />
  <input type="hidden" name="redirect" value={redirect} />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <h3 class="text-xl font-bold">Wyślij zapytanie</h3>
  <p class="mt-1.5 text-sm text-slate-500">Oddzwonimy lub odpiszemy najszybciej, jak to możliwe.</p>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-name" class="field-label">Imię i nazwisko <span class="text-brand-red-600">*</span></label>
      <input id="cf-name" name="name" type="text" class="field" autocomplete="name" required maxlength="100" />
    </div>
    <div>
      <label for="cf-phone" class="field-label">Telefon <span class="text-brand-red-600">*</span></label>
      <input
        id="cf-phone"
        name="Telefon"
        type="tel"
        class="field"
        autocomplete="tel"
        inputmode="tel"
        required
        pattern="[\d\s\+\-\(\)]{9,20}"
        placeholder="np. 600 100 200"
      />
    </div>
    <div>
      <label for="cf-email" class="field-label">E-mail <span class="font-normal text-slate-500">(opcjonalnie)</span></label>
      <input id="cf-email" name="email" type="email" class="field" autocomplete="email" maxlength="120" />
    </div>
    <div>
      <label for="cf-service" class="field-label">Czego dotyczy zapytanie?</label>
      <select id="cf-service" name="Usługa" class="field appearance-auto">
        {contactServices.map((s) => <option value={s}>{s}</option>)}
      </select>
    </div>
    <div>
      <label for="cf-date" class="field-label">Preferowany termin <span class="font-normal text-slate-500">(opcjonalnie)</span></label>
      <input id="cf-date" name="Termin" type="text" class="field" placeholder="np. 14.10, rano" maxlength="80" />
    </div>
    <div>
      <label for="cf-route" class="field-label">Trasa <span class="font-normal text-slate-500">(opcjonalnie)</span></label>
      <input id="cf-route" name="Trasa" type="text" class="field" placeholder="np. Bukowiec → Bydgoszcz" maxlength="160" />
    </div>
    <div class="sm:col-span-2">
      <label for="cf-message" class="field-label">Wiadomość <span class="text-brand-red-600">*</span></label>
      <textarea id="cf-message" name="Wiadomość" rows="5" class="field resize-y" required maxlength="2000"></textarea>
      <p class="mt-2 text-xs text-slate-500">
        Prosimy nie podawać w formularzu szczegółowych informacji o stanie zdrowia. Ustalimy je telefonicznie.
      </p>
    </div>
  </div>

  <div class="mt-5 flex items-start gap-3">
    <input
      id="cf-consent"
      name="Zgoda na przetwarzanie danych"
      type="checkbox"
      value="Tak"
      required
      class="mt-0.5 size-5 shrink-0 rounded border-slate-300 accent-navy-700"
    />
    <label for="cf-consent" class="text-sm leading-relaxed text-slate-600">
      Wyrażam zgodę na przetwarzanie moich danych w celu odpowiedzi na zapytanie, zgodnie z
      <a href={url('polityka-prywatnosci/')} class="font-medium text-navy-700 underline underline-offset-2">polityką prywatności</a>.
      <span class="text-brand-red-600">*</span>
    </label>
  </div>

  <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <button type="submit" class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto" disabled={!isLive} data-submit>
      <Send class="size-[1.1rem]" aria-hidden="true" />
      <span data-submit-label>Wyślij wiadomość</span>
    </button>
    <p class="text-xs text-slate-500"><span class="text-brand-red-600">*</span> pola wymagane</p>
  </div>

  <div class="mt-5 hidden rounded-2xl px-4 py-3 text-sm" role="status" aria-live="polite" data-status></div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const isLive = form.dataset.live === 'true';

    // The button starts disabled in preview mode so the no-JS fallback never posts without a key.
    submit.disabled = false;

    const show = (kind: 'success' | 'error' | 'info', message: string) => {
      status.className = 'mt-5 rounded-2xl px-4 py-3 text-sm';
      status.classList.add(
        ...{
          success: ['bg-emerald-50', 'text-emerald-900', 'ring-1', 'ring-emerald-200'],
          error: ['bg-red-50', 'text-red-900', 'ring-1', 'ring-red-200'],
          info: ['bg-navy-50', 'text-navy-900', 'ring-1', 'ring-navy-200'],
        }[kind],
      );
      status.textContent = message;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (!isLive) {
        show(
          'info',
          'To wersja podglądowa strony. Formularz zostanie aktywowany po podłączeniu skrzynki e-mail. Prosimy o kontakt telefoniczny.',
        );
        return;
      }

      submit.disabled = true;
      label.textContent = 'Wysyłanie…';

      try {
        const data = Object.fromEntries(new FormData(form));
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message);

        form.reset();
        show('success', 'Dziękujemy! Wiadomość została wysłana. Skontaktujemy się najszybciej, jak to możliwe.');
      } catch {
        show('error', 'Nie udało się wysłać wiadomości. Spróbuj ponownie lub zadzwoń do nas.');
      } finally {
        submit.disabled = false;
        label.textContent = 'Wyślij wiadomość';
      }
    });
  }
</script>
