---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Ambulance from '@lucide/astro/icons/ambulance';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import BriefcaseMedical from '@lucide/astro/icons/briefcase-medical';
import Check from '@lucide/astro/icons/check';
import Clock from '@lucide/astro/icons/clock';
import ExternalLink from '@lucide/astro/icons/external-link';
import HandHeart from '@lucide/astro/icons/hand-heart';
import HeartPulse from '@lucide/astro/icons/heart-pulse';
import Hospital from '@lucide/astro/icons/hospital';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Navigation from '@lucide/astro/icons/navigation';
import PartyPopper from '@lucide/astro/icons/party-popper';
import Phone from '@lucide/astro/icons/phone';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Stethoscope from '@lucide/astro/icons/stethoscope';
import Users from '@lucide/astro/icons/users';
import ContactForm from '../components/ContactForm.astro';
import Emblem from '../components/Emblem.astro';
import Placeholder from '../components/Placeholder.astro';
import Base from '../layouts/Base.astro';
import {
  audiences,
  company,
  faqs,
  fullAddress,
  mailHref,
  mapsHref,
  photosAreIllustrative,
  services,
  steps,
  telHref,
  values,
} from '../data/company';
import { siteConfig } from '../../site.config.mjs';

const serviceIcons = { ambulance: Ambulance, stethoscope: Stethoscope, 'first-aid': BriefcaseMedical } as const;
const audienceIcons = [Users, Hospital, PartyPopper];
const valueIcons = [ShieldCheck, Clock, HandHeart, HeartPulse];

/** Photos dropped into src/assets/photos/ are picked up automatically by file name. */
const photoFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = (name: string) =>
  Object.entries(photoFiles).find(([path]) => path.split('/').pop()?.split('.')[0] === name)?.[1].default;

const gallery = [
  { name: 'ambulans', alt: 'Ambulans KASIA MED', hint: 'ambulans z zewnątrz' },
  { name: 'wnetrze', alt: 'Wnętrze ambulansu przystosowane do przewozu pacjenta', hint: 'wnętrze ambulansu' },
  { name: 'zespol', alt: 'Zabezpieczenie medyczne wydarzenia', hint: 'zespół lub zabezpieczenie wydarzenia' },
].map((item) => ({ ...item, image: photo(item.name) }));
const showGallery = gallery.some((g) => g.image) || !siteConfig.indexable;

const answerParts = (text: string) =>
  text.split(/(\{placeholder:[^}]+\})/).map((part) => {
    const match = part.match(/^\{placeholder:([^}]+)\}$/);
    return match ? { placeholder: match[1] } : { text: part };
  });
---

<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-mist via-white to-white">
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgb(31_58_122/0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgb(31_58_122/0.05)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"
      aria-hidden="true"
    >
    </div>
    <div class="pointer-events-none absolute -top-40 -right-40 size-[38rem] rounded-full bg-navy-200/40 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-1/2 -left-48 size-[28rem] rounded-full bg-brand-red-100/50 blur-3xl" aria-hidden="true"></div>

    <div class="container-page relative grid items-center gap-14 pt-14 pb-20 lg:grid-cols-[1.15fr_1fr] lg:gap-10 lg:pt-20 lg:pb-28">
      <div>
        <p class="inline-flex items-center gap-2.5 rounded-full bg-white px-4 py-2 text-sm font-medium text-navy-800 ring-1 ring-navy-100 shadow-sm">
          <span class="pulse-dot size-2.5 rounded-full bg-emerald-500"></span>
          Dyspozytornia czynna całą dobę
        </p>
        <h1 class="mt-7 text-[2.6rem] leading-[1.05] font-extrabold sm:text-6xl lg:text-[4.1rem]">
          Twoje zdrowie,<br />
          <span class="text-navy-700">nasz </span><span class="relative whitespace-nowrap text-brand-red-600">
            priorytet.
            <svg class="absolute -bottom-2 left-0 h-3 w-full text-brand-red-600/30" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true">
              <path d="M0 8 H70 L78 2 L86 11 L94 4 L100 8 H200" fill="none" stroke="currentColor" stroke-width="2.5" vector-effect="non-scaling-stroke" />
            </svg>
          </span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-slate-600 sm:text-xl">
          Profesjonalny transport sanitarny, kompleksowa opieka medyczna i zabezpieczenie medyczne wydarzeń.
          Bezpiecznie, punktualnie i z troską o każdego pacjenta.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={telHref} class="btn-primary !min-h-14 !px-7 text-base">
            <Phone class="size-5" aria-hidden="true" />
            Zadzwoń: {company.phone.display}
          </a>
          <a href="#kontakt" class="btn-secondary !min-h-14 !px-7 text-base">
            Wyślij zapytanie
            <ArrowRight class="size-5" aria-hidden="true" />
          </a>
        </div>
        <dl class="mt-12 grid max-w-xl grid-cols-2 gap-6 sm:grid-cols-3 border-t border-navy-100 pt-8">
          <div>
            <dt class="text-xs font-medium tracking-wide text-slate-500 uppercase">Dyspozytornia</dt>
            <dd class="mt-1 font-display text-2xl font-extrabold text-navy-900">24/7</dd>
          </div>
          <div>
            <dt class="text-xs font-medium tracking-wide text-slate-500 uppercase">Wycena</dt>
            <dd class="mt-1 font-display text-2xl font-extrabold text-navy-900">Indywidualna</dd>
          </div>
          <div>
            <dt class="text-xs font-medium tracking-wide text-slate-500 uppercase">Biuro</dt>
            <dd class="mt-1 font-display text-2xl font-extrabold text-navy-900">{company.address.city}</dd>
          </div>
        </dl>
      </div>

      <div class="relative mx-auto w-full max-w-[18rem] sm:max-w-md lg:max-w-none">
        <div class="relative mx-auto aspect-square w-full max-w-[28rem]">
          <div class="absolute inset-[6%] rounded-full bg-white shadow-[0_40px_100px_-30px_rgb(15_31_69/0.35)] ring-1 ring-navy-100"></div>
          <svg class="absolute inset-x-[-12%] top-1/2 h-24 w-[124%] -translate-y-1/2 text-brand-red-600/25" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true">
            <path
              class="ecg-draw"
              pathLength="1"
              d="M0 50 H170 L190 50 L200 30 L212 80 L226 8 L240 92 L252 50 H600"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linejoin="round"
              vector-effect="non-scaling-stroke"
            />
          </svg>
          <div class="absolute inset-[9%]">
            <Emblem />
          </div>

          <div class="card absolute bottom-[3%] -left-3 hidden sm:flex items-center gap-3 !rounded-2xl px-4 py-3 sm:-left-8">
            <span class="grid size-10 place-items-center rounded-xl bg-brand-red-50 text-brand-red-600">
              <Phone class="size-5" aria-hidden="true" />
            </span>
            <span class="leading-tight">
              <span class="block text-xs text-slate-500">Całodobowa dyspozytornia</span>
              <a href={telHref} class="font-display text-lg font-bold text-navy-900">{company.phone.display}</a>
            </span>
          </div>
          <div class="card absolute top-[3%] -right-3 hidden sm:flex items-center gap-3 !rounded-2xl px-4 py-3 sm:-right-6">
            <span class="grid size-10 place-items-center rounded-xl bg-navy-50 text-navy-700">
              <MapPin class="size-5" aria-hidden="true" />
            </span>
            <span class="leading-tight">
              <span class="block text-xs text-slate-500">Biuro</span>
              <span class="font-display font-bold text-navy-900">{company.address.city}</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="uslugi" class="scroll-mt-24 py-20 lg:py-28">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Nasze usługi</p>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-[2.6rem] sm:leading-tight">Kompleksowe wsparcie medyczne w jednym miejscu</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          Od bezpiecznego przewozu pacjenta, przez opiekę medyczną, po zabezpieczenie wydarzeń. Jeden telefon wystarczy,
          żeby wszystko zorganizować.
        </p>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {
          services.map((service, index) => {
            const Icon = serviceIcons[service.icon as keyof typeof serviceIcons];
            return (
              <article id={service.id} class="card group relative flex scroll-mt-28 flex-col overflow-hidden p-8 transition duration-300 hover:-translate-y-1 hover:shadow-[0_30px_60px_-20px_rgb(15_31_69/0.25)]">
                <span class="absolute top-0 left-8 h-1 w-16 rounded-b-full bg-gradient-to-r from-navy-700 to-brand-red-600" aria-hidden="true" />
                <div class="flex items-center justify-between">
                  <span class="grid size-14 place-items-center rounded-2xl bg-navy-50 text-navy-700 ring-1 ring-navy-100 transition group-hover:bg-navy-700 group-hover:text-white">
                    <Icon class="size-7" aria-hidden="true" />
                  </span>
                  <svg class="h-10 w-16 text-navy-100" viewBox="0 0 64 40" aria-hidden="true">
                    <text x="64" y="36" text-anchor="end" fill="currentColor" font-size="46" font-weight="800" letter-spacing="-2">
                      0{index + 1}
                    </text>
                  </svg>
                </div>
                <h3 class="mt-7 text-xl font-bold">{service.title}</h3>
                <p class="mt-3 leading-relaxed text-slate-600">{service.lead}</p>
                <ul class="mt-6 space-y-3 border-t border-slate-100 pt-6">
                  {service.items.map((item) => (
                    <li class="flex gap-3 text-[0.95rem]">
                      <Check class="mt-0.5 size-5 shrink-0 text-brand-red-600" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Audiences -->
  <section class="bg-mist py-20 lg:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div>
        <p class="eyebrow">Dla kogo</p>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">Pomagamy pacjentom, rodzinom i instytucjom</h2>
        <p class="mt-5 leading-relaxed text-slate-600">
          Każde zlecenie traktujemy indywidualnie, niezależnie od tego, czy chodzi o jeden przejazd, stałą opiekę czy
          całodniowe wydarzenie.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-3">
        {
          audiences.map((audience, index) => {
            const Icon = audienceIcons[index];
            return (
              <div class="rounded-3xl bg-white p-7 ring-1 ring-slate-900/5">
                <Icon class="size-7 text-brand-red-600" aria-hidden="true" />
                <h3 class="mt-5 text-lg font-bold">{audience.title}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-slate-600">{audience.text}</p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="jak-dzialamy" class="relative scroll-mt-24 overflow-hidden bg-navy-900 py-20 text-navy-100 lg:py-28">
    <svg class="pointer-events-none absolute inset-x-0 top-1/2 h-40 w-full -translate-y-1/2 text-white/[0.05]" viewBox="0 0 1200 160" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 80 H520 L545 80 L560 40 L578 130 L598 10 L618 150 L634 80 H1200" fill="none" stroke="currentColor" stroke-width="3" vector-effect="non-scaling-stroke" />
    </svg>
    <div class="container-page relative">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow !text-red-300">Jak działamy</p>
        <h2 class="mt-4 text-3xl font-extrabold !text-white sm:text-[2.6rem] sm:leading-tight">Prosto, szybko i bez stresu</h2>
        <p class="mt-5 text-lg text-navy-200">Wiemy, że w sprawach zdrowia liczy się czas. Dlatego cały proces ograniczamy do minimum.</p>
      </div>
      <ol class="mt-16 grid gap-6 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li class="relative rounded-3xl bg-white/[0.04] p-8 ring-1 ring-white/10 backdrop-blur">
              <span class="grid size-12 place-items-center rounded-full bg-brand-red-600 font-display text-lg font-bold text-white shadow-lg shadow-brand-red-600/30">
                {index + 1}
              </span>
              <h3 class="mt-6 text-xl font-bold !text-white">{step.title}</h3>
              <p class="mt-3 leading-relaxed text-navy-200">{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-14 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={telHref} class="btn-primary !min-h-14 !px-7 text-base">
          <Phone class="size-5" aria-hidden="true" />
          {company.phone.display}
        </a>
        <a href="#kontakt" class="btn-ghost-light !min-h-14 !px-7 text-base">Napisz do nas</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="o-nas" class="scroll-mt-24 py-20 lg:py-28">
    <div class="container-page grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">O nas</p>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-[2.6rem] sm:leading-tight">Opieka, na której możesz polegać</h2>
        <div class="mt-6 space-y-5 text-lg leading-relaxed text-slate-600">
          <p>
            {company.name} to firma medyczna z siedzibą w miejscowości {company.address.city} (woj. {company.address.region}).
            Zajmujemy się transportem sanitarnym, opieką medyczną oraz zabezpieczeniem medycznym wydarzeń.
          </p>
          <p>
            Naszym priorytetem jest bezpieczeństwo i komfort pacjentów oraz spokój ich bliskich. Do każdego zlecenia
            podchodzimy z zaangażowaniem, empatią i pełnym profesjonalizmem.
          </p>
          <p><Placeholder label="historia firmy, doświadczenie i kwalifikacje zespołu, flota" /></p>
        </div>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          values.map((value, index) => {
            const Icon = valueIcons[index];
            return (
              <div class="card p-7">
                <span class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-navy-700 to-navy-900 text-white shadow-lg shadow-navy-900/20">
                  <Icon class="size-6" aria-hidden="true" />
                </span>
                <h3 class="mt-5 text-lg font-bold">{value.title}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-slate-600">{value.text}</p>
              </div>
            );
          })
        }
      </div>
    </div>

    {
      showGallery && (
        <div class="container-page mt-20">
          <div class="grid gap-5 md:grid-cols-3 md:grid-rows-2">
            {gallery.map((item, index) =>
              item.image ? (
                <figure class:list={['relative overflow-hidden rounded-3xl', index === 0 && 'md:col-span-2 md:row-span-2']}>
                  <Image
                    src={item.image}
                    alt={item.alt}
                    widths={[480, 800, 1200, 1600]}
                    sizes={index === 0 ? '(min-width: 768px) 66vw, 100vw' : '(min-width: 768px) 33vw, 100vw'}
                    class:list={['aspect-[4/3] h-full w-full object-cover', index === 0 && 'md:aspect-auto']}
                  />
                  {photosAreIllustrative && (
                    <figcaption class="absolute bottom-3 left-3 rounded-full bg-navy-950/75 px-3 py-1 text-xs font-medium text-white backdrop-blur">
                      Zdjęcie poglądowe
                    </figcaption>
                  )}
                </figure>
              ) : (
                <div
                  class:list={[
                    'grid aspect-[4/3] place-items-center rounded-3xl border-2 border-dashed border-navy-200 bg-mist p-6 text-center',
                    index === 0 && 'md:col-span-2 md:row-span-2 md:aspect-auto',
                  ]}
                >
                  <div>
                    <Ambulance class="mx-auto size-10 text-navy-300" aria-hidden="true" />
                    <p class="mt-3 text-sm font-medium text-navy-700">Miejsce na zdjęcie: {item.hint}</p>
                    <p class="mt-1 text-xs text-slate-600">widoczne tylko w wersji podglądowej</p>
                  </div>
                </div>
              ),
            )}
          </div>
        </div>
      )
    }
  </section>

  <!-- CTA band -->
  <section class="container-page">
    <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-red-600 to-brand-red-700 px-8 py-12 text-white sm:px-14 sm:py-14">
      <svg class="pointer-events-none absolute inset-0 h-full w-full text-white/10" viewBox="0 0 800 200" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 120 H360 L380 120 L392 70 L408 170 L426 30 L444 190 L458 120 H800" fill="none" stroke="currentColor" stroke-width="3" vector-effect="non-scaling-stroke" />
      </svg>
      <div class="relative flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
        <div>
          <h2 class="text-3xl font-extrabold !text-white sm:text-4xl">Potrzebujesz transportu lub opieki?</h2>
          <p class="mt-3 max-w-xl text-lg text-white/85">Zadzwoń do naszej dyspozytorni. Odbieramy całą dobę, 7 dni w tygodniu.</p>
        </div>
        <a href={telHref} class="btn !min-h-16 shrink-0 bg-white !px-8 text-lg text-brand-red-700 shadow-xl hover:-translate-y-0.5">
          <Phone class="size-6" aria-hidden="true" />
          {company.phone.display}
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-24 py-20 lg:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-[2.6rem] sm:leading-tight">Najczęściej zadawane pytania</h2>
        <p class="mt-5 leading-relaxed text-slate-600">
          Nie znalazłeś odpowiedzi? Zadzwoń pod numer
          <a href={telHref} class="font-semibold whitespace-nowrap text-navy-700 hover:underline">{company.phone.display}</a>, a chętnie pomożemy.
        </p>
      </div>
      <div class="divide-y divide-slate-200 border-y border-slate-200">
        {
          faqs.map((faq) => (
            <details class="group py-2 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-xl py-4 text-left font-display text-lg font-semibold text-navy-900">
                {faq.q}
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-navy-50 text-navy-700 transition group-open:rotate-45 group-open:bg-navy-700 group-open:text-white" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                </span>
              </summary>
              <p class="pr-12 pb-5 leading-relaxed text-slate-600">
                {answerParts(faq.a).map((part) => ('placeholder' in part ? <Placeholder label={part.placeholder!} /> : part.text))}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="kontakt" class="scroll-mt-24 bg-mist py-20 lg:py-28">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Kontakt</p>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-[2.6rem] sm:leading-tight">Skontaktuj się z nami</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          W pilnych sprawach najlepiej zadzwonić. W pozostałych możesz napisać, a odpowiemy najszybciej, jak to możliwe.
        </p>
      </div>

      <div class="mt-14 grid gap-8 lg:grid-cols-[1fr_1.35fr]">
        <div class="flex flex-col gap-5">
          <a href={telHref} class="group relative overflow-hidden rounded-3xl bg-navy-800 p-7 text-white shadow-xl shadow-navy-900/20 transition hover:bg-navy-700">
            <span class="flex items-center gap-2 text-sm text-navy-200">
              <span class="pulse-dot size-2 rounded-full bg-emerald-400"></span>
              Całodobowa dyspozytornia
            </span>
            <span class="mt-3 flex items-center gap-3 font-display text-3xl font-extrabold sm:text-4xl">
              <Phone class="size-8 text-brand-red-500" aria-hidden="true" />
              {company.phone.display}
            </span>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-navy-100 group-hover:gap-2.5 transition-all">
              Zadzwoń teraz <ArrowRight class="size-4" aria-hidden="true" />
            </span>
          </a>

          <div class="card divide-y divide-slate-100">
            <div class="flex gap-4 p-6">
              <Mail class="mt-0.5 size-5 shrink-0 text-brand-red-600" aria-hidden="true" />
              <div>
                <p class="text-sm text-slate-500">E-mail</p>
                {mailHref ? <a href={mailHref} class="font-semibold text-navy-900 hover:underline">{company.email}</a> : <Placeholder label="adres e-mail" />}
              </div>
            </div>
            <div class="flex gap-4 p-6">
              <MapPin class="mt-0.5 size-5 shrink-0 text-brand-red-600" aria-hidden="true" />
              <div>
                <p class="text-sm text-slate-500">Adres biura</p>
                <p class="font-semibold text-navy-900">{fullAddress}</p>
                <p class="text-sm text-slate-500">woj. {company.address.region}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-navy-50 px-3.5 py-1.5 text-sm font-medium text-navy-800 hover:bg-navy-100">
                    <Navigation class="size-4" aria-hidden="true" />
                    Pokaż na mapie
                    <ExternalLink class="size-3.5 opacity-60" aria-hidden="true" />
                    <span class="sr-only">(otwiera się w nowej karcie)</span>
                  </a>
                </div>
              </div>
            </div>
            <div class="flex gap-4 p-6">
              <Clock class="mt-0.5 size-5 shrink-0 text-brand-red-600" aria-hidden="true" />
              <div>
                <p class="text-sm text-slate-500">Godziny</p>
                <p class="font-semibold text-navy-900">Dyspozytornia: {company.dispatchHours.toLowerCase()}</p>
                <p class="text-sm text-slate-600">Biuro: {company.officeHours ?? <Placeholder label="godziny biura" />}</p>
              </div>
            </div>
            <div class="flex gap-4 p-6">
              <Ambulance class="mt-0.5 size-5 shrink-0 text-brand-red-600" aria-hidden="true" />
              <div>
                <p class="text-sm text-slate-500">Obszar działania</p>
                <p class="font-semibold text-navy-900">{company.serviceArea ?? <Placeholder label="obszar działania" />}</p>
              </div>
            </div>
          </div>
        </div>

        <ContactForm />
      </div>
    </div>
  </section>
</Base>
