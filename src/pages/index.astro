---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Ambulance from '@lucide/astro/icons/ambulance';
import BriefcaseMedical from '@lucide/astro/icons/briefcase-medical';
import Check from '@lucide/astro/icons/check';
import Clock from '@lucide/astro/icons/clock';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Phone from '@lucide/astro/icons/phone';
import Stethoscope from '@lucide/astro/icons/stethoscope';
import ContactForm from '../components/ContactForm.astro';
import Emblem from '../components/Emblem.astro';
import Placeholder from '../components/Placeholder.astro';
import Base from '../layouts/Base.astro';
import {
  company,
  faqs,
  fullAddress,
  mailHref,
  mapsHref,
  photosAreIllustrative,
  services,
  steps,
  telHref,
} from '../data/company';

const serviceIcons = { ambulance: Ambulance, stethoscope: Stethoscope, 'first-aid': BriefcaseMedical } as const;

/** Photos dropped into src/assets/photos/ are picked up automatically by file name. */
const photoFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = (name: string) =>
  Object.entries(photoFiles).find(([path]) => path.split('/').pop()?.split('.')[0] === name)?.[1].default;

const heroPhoto = photo('ambulans');
const extraPhotos = [
  { image: photo('wnetrze'), alt: 'Wnętrze ambulansu przystosowane do przewozu pacjenta' },
  { image: photo('zespol'), alt: 'Zespół KASIA MED podczas zabezpieczenia wydarzenia' },
].filter((p): p is { image: ImageMetadata; alt: string } => Boolean(p.image));

const answerParts = (text: string) =>
  text.split(/(\{placeholder:[^}]+\})/).map((part) => {
    const match = part.match(/^\{placeholder:([^}]+)\}$/);
    return match ? { placeholder: match[1] } : { text: part };
  });
---

<Base>
  <!-- Hero: what we do, the phone number and the ambulance. Nothing else competes for attention. -->
  <section class="bg-gradient-to-b from-mist to-white">
    <div class="container-page grid items-center gap-10 pt-10 pb-12 lg:grid-cols-[1.05fr_1fr] lg:gap-14 lg:pt-14 lg:pb-16">
      <div>
        <p class="text-lg font-semibold text-brand-red-600">{company.address.city} · woj. {company.address.region}</p>
        <h1 class="mt-3 text-[2.4rem] leading-[1.1] font-extrabold sm:text-5xl lg:text-[3.6rem]">
          Transport sanitarny i&nbsp;opieka medyczna
        </h1>
        <p class="mt-5 max-w-xl text-xl leading-relaxed text-slate-700">
          Przewóz pacjentów ambulansem, opieka nad chorymi i zabezpieczenie medyczne imprez.
        </p>

        <div class="mt-8">
          <a
            href={telHref}
            class="inline-flex min-h-16 w-full items-center justify-center gap-3 rounded-2xl bg-brand-red-600 px-8 text-2xl font-bold text-white shadow-[0_12px_30px_-10px_rgb(198_40_40/0.7)] transition hover:bg-brand-red-700 sm:w-auto sm:text-[1.7rem]"
          >
            <Phone class="size-7" aria-hidden="true" />
            {company.phone.display}
          </a>
          <p class="mt-3 flex items-start gap-2 text-lg text-slate-700">
            <Clock class="mt-1 size-5 shrink-0 text-emerald-600" aria-hidden="true" />
            <span>Odbieramy <strong class="font-semibold text-navy-900">całą dobę, 7 dni w tygodniu</strong></span>
          </p>
        </div>

        <ul class="mt-8 space-y-3 text-lg text-navy-900">
          <li class="flex items-start gap-3">
            <Check class="mt-0.5 size-6 shrink-0 text-brand-red-600" aria-hidden="true" />
            Cenę podajemy przez telefon, przed przejazdem
          </li>
          <li class="flex items-start gap-3">
            <Check class="mt-0.5 size-6 shrink-0 text-brand-red-600" aria-hidden="true" />
            Biuro: {fullAddress}
          </li>
        </ul>
      </div>

      <div>
        {
          heroPhoto ? (
            <figure class="relative overflow-hidden rounded-3xl shadow-[0_30px_70px_-30px_rgb(15_31_69/0.45)]">
              <Image
                src={heroPhoto}
                alt={`Ambulans ${company.name}`}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 600px, 100vw"
                loading="eager"
                fetchpriority="high"
                class="aspect-[16/11] w-full object-cover object-[center_40%]"
              />
              {photosAreIllustrative && (
                <figcaption class="absolute bottom-3 left-3 rounded-full bg-navy-950/75 px-3 py-1 text-sm text-white">
                  Zdjęcie poglądowe
                </figcaption>
              )}
            </figure>
          ) : (
            <Emblem class="mx-auto w-full max-w-sm" />
          )
        }
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="uslugi" class="scroll-mt-24 py-16 lg:py-20">
    <div class="container-page">
      <h2 class="text-3xl font-extrabold sm:text-4xl">W czym pomagamy</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          services.map((service) => {
            const Icon = serviceIcons[service.icon];
            return (
              <article id={service.id} class="card scroll-mt-28 p-7 sm:p-8">
                <span class="grid size-14 place-items-center rounded-2xl bg-navy-50 text-navy-700">
                  <Icon class="size-8" aria-hidden="true" />
                </span>
                <h3 class="mt-5 text-2xl font-bold">{service.title}</h3>
                <p class="mt-2 text-lg text-slate-700">{service.lead}</p>
                <ul class="mt-5 space-y-3">
                  {service.items.map((item) => (
                    <li class="flex gap-3 text-lg">
                      <Check class="mt-1 size-5 shrink-0 text-brand-red-600" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- How to order -->
  <section id="jak-zamowic" class="scroll-mt-24 bg-navy-900 py-16 text-white lg:py-20">
    <div class="container-page">
      <h2 class="text-3xl font-extrabold !text-white sm:text-4xl">Jak zamówić?</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li class="flex gap-5">
              <span class="grid size-14 shrink-0 place-items-center rounded-full bg-brand-red-600 text-2xl font-bold">{index + 1}</span>
              <div>
                <h3 class="text-2xl font-bold !text-white">{step.title}</h3>
                <p class="mt-1 text-lg text-navy-100">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <a
        href={telHref}
        class="mt-12 inline-flex min-h-16 w-full items-center justify-center gap-3 rounded-2xl bg-white px-8 text-2xl font-bold text-brand-red-700 transition hover:bg-navy-50 sm:w-auto"
      >
        <Phone class="size-7" aria-hidden="true" />
        {company.phone.display}
      </a>
    </div>
  </section>

  <!-- About -->
  <section id="o-nas" class="scroll-mt-24 py-16 lg:py-20">
    <div class="container-page max-w-4xl">
      <h2 class="text-3xl font-extrabold sm:text-4xl">O nas</h2>
      <div class="mt-6 space-y-5 text-xl leading-relaxed text-slate-700">
        <p>
          {company.name} to firma z miejscowości {company.address.city}. Zajmujemy się transportem sanitarnym,
          opieką medyczną i zabezpieczeniem medycznym imprez. Najważniejsze są dla nas bezpieczeństwo pacjenta
          i spokój jego bliskich.
        </p>
        <p><Placeholder label="kilka zdań o firmie: od kiedy działa, kto jest w zespole, jakie ma pojazdy" /></p>
      </div>
      {
        extraPhotos.length > 0 && (
          <div class:list={['mt-10 grid gap-5', extraPhotos.length === 2 && 'sm:grid-cols-2']}>
            {extraPhotos.map((p) => (
              <figure class="relative overflow-hidden rounded-3xl">
                <Image src={p.image} alt={p.alt} widths={[480, 800, 1200]} sizes="(min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
                {photosAreIllustrative && (
                  <figcaption class="absolute bottom-3 left-3 rounded-full bg-navy-950/75 px-3 py-1 text-sm text-white">Zdjęcie poglądowe</figcaption>
                )}
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- FAQ -->
  <section id="pytania" class="scroll-mt-24 bg-mist py-16 lg:py-20">
    <div class="container-page max-w-4xl">
      <h2 class="text-3xl font-extrabold sm:text-4xl">Częste pytania</h2>
      <div class="mt-8 space-y-4">
        {
          faqs.map((faq) => (
            <details class="group rounded-2xl bg-white ring-1 ring-slate-200 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 px-6 py-4 text-xl font-semibold text-navy-900">
                {faq.q}
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-navy-50 text-navy-700 transition group-open:rotate-45" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                </span>
              </summary>
              <p class="px-6 pb-6 text-lg leading-relaxed text-slate-700">
                {answerParts(faq.a).map((part) => ('placeholder' in part ? <Placeholder label={part.placeholder!} /> : part.text))}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="kontakt" class="scroll-mt-24 py-16 lg:py-20">
    <div class="container-page">
      <h2 class="text-3xl font-extrabold sm:text-4xl">Kontakt</h2>
      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        <div class="space-y-8">
          <a href={telHref} class="block rounded-3xl bg-navy-800 p-7 text-white transition hover:bg-navy-700 sm:p-8">
            <span class="text-lg text-navy-100">Telefon, całą dobę</span>
            <span class="mt-2 flex items-center gap-3 text-4xl font-extrabold sm:text-5xl">
              <Phone class="size-9 shrink-0 text-red-300" aria-hidden="true" />
              {company.phone.display}
            </span>
          </a>
          <ul class="space-y-6 text-lg">
            <li class="flex gap-4">
              <MapPin class="mt-1 size-6 shrink-0 text-brand-red-600" aria-hidden="true" />
              <div>
                <p class="text-slate-600">Adres biura</p>
                <p class="font-semibold text-navy-900">{fullAddress}</p>
                <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block font-medium text-navy-700 underline underline-offset-4">
                  Pokaż na mapie<span class="sr-only"> (otwiera się w nowej karcie)</span>
                </a>
              </div>
            </li>
            <li class="flex gap-4">
              <Mail class="mt-1 size-6 shrink-0 text-brand-red-600" aria-hidden="true" />
              <div>
                <p class="text-slate-600">E-mail</p>
                {mailHref ? <a href={mailHref} class="font-semibold text-navy-900 underline underline-offset-4">{company.email}</a> : <Placeholder label="adres e-mail" />}
              </div>
            </li>
            <li class="flex gap-4">
              <Clock class="mt-1 size-6 shrink-0 text-brand-red-600" aria-hidden="true" />
              <div>
                <p class="text-slate-600">Godziny</p>
                <p class="font-semibold text-navy-900">Telefon: całą dobę</p>
                <p>Biuro: {company.officeHours ?? <Placeholder label="godziny biura" />}</p>
              </div>
            </li>
            <li class="flex gap-4">
              <Ambulance class="mt-1 size-6 shrink-0 text-brand-red-600" aria-hidden="true" />
              <div>
                <p class="text-slate-600">Obszar działania</p>
                <p class="font-semibold text-navy-900">{company.serviceArea ?? <Placeholder label="obszar działania" />}</p>
              </div>
            </li>
          </ul>
        </div>

        <ContactForm />
      </div>
    </div>
  </section>
</Base>
